# Application Settings
APP_NAME="Attendance Monitoring System"
APP_ENV=development
SECRET_KEY=your-super-secret-key-change-in-production
JWT_SECRET=your-jwt-secret-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database
DATABASE_URL=sqlite:///./database/attendance.db

# CORS — TRD §36
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Face Recognition — TRD §36
# Threshold is a distance value: 0.0 = identical, 1.0 = totally different.
# Lower = stricter matching. Validate experimentally; do NOT hard-code a guaranteed accuracy.
FACE_RECOGNITION_THRESHOLD=0.50
FACE_MATCH_THRESHOLD=0.50
FACE_SAMPLES_REQUIRED=10

# Directories
UPLOAD_DIRECTORY=./uploads
BACKUP_DIRECTORY=./backups
FACE_ENCODINGS_DIRECTORY=./face_encodings
REPORTS_DIRECTORY=./reports

# Camera — TRD §36
CAMERA_INDEX=0
DEFAULT_CAMERA_INDEX=0
DEFAULT_CAMERA_RESOLUTION=640x480
